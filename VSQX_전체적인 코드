<body>
    <div class="card">
        <h2>vsqx 변환</h2>
        
        <label>1. 오디오 파일 (.wav)</label>
        <input type="file" id="fileInput" accept="audio/*">
        
        <label>2. 곡의 BPM</label>
        <input type="number" id="bpmInput" value="120">
        
        <label>3. 가사</label>
        <textarea id="lyricsInput" rows="6" placeholder="여기에 가사를 입력하세요."></textarea>
        
        <button onclick="uploadFile()">VSQX 생성 시작</button>
        <p id="status"></p>
    </div>

    <script>
        // 코랩의 ✅ 서버 주소를 이곳에 붙여넣으세요.
        const API_URL = "https://disfigure-pasta-waggle.ngrok-free.dev"; 

        async function uploadFile() {
            const status = document.getElementById('status');
            const file = document.getElementById('fileInput').files[0];
            const bpm = document.getElementById('bpmInput').value;
            const lyrics = document.getElementById('lyricsInput').value;

            if(!file) return alert("파일을 선택해 주세요!");
            if(!API_URL.startsWith("http")) return alert("코랩 주소를 입력해 주세요!");

            status.innerText = "⏳ 서버에서 변환 중입니다...";
            status.style.color = "#007bff";

            const formData = new FormData();
            formData.append("file", file);
            formData.append("bpm", bpm);
            formData.append("full_lyrics", lyrics);

            try {
                const response = await fetch(`${API_URL}/convert`, { 
                    method: "POST", 
                    body: formData 
                });

                if(!response.ok) throw new Error("서버 응답 실패");

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `vsqx_result_${Date.now()}.vsqx`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                
                status.innerText = "✅ 성공! 파일이 다운로드되었습니다.";
                status.style.color = "#28a745";
            } catch (e) {
                status.innerText = "❌ 오류: " + e.message;
                status.style.color = "#dc3545";
            }
        }
    </script>
