			<cc><t>0</t><v id="X">15</v></cc>
			<cc><t>0</t><v id="G">40</v></cc>
			<cc><t>0</t><v id="C">10</v></cc>
			<cc><t>0</t><v id="D">64</v></cc>'''

        # 5. Note 생성부
        # 5. Note 생성부 (vsPart 내부에서 반복 호출)
        tps = (bpm / 60) * 480
        for seg in res['segments']:
            for w in seg.get('words', []):
                start, end, text = w['start'], w['end'], w['word'].strip()
                if not text: continue

                # 가사 매칭 (사용자 입력 가사가 있으면 우선 적용, 없으면 AI 인식 가사 사용)
                if user_lyrics and lyric_idx < len(user_lyrics):
                    hira = "".join([i['hira'] for i in kks.convert(user_lyrics[lyric_idx])])
                    lyric_idx += 1
                else:
                    hira = "".join([i['hira'] for i in kks.convert(text)])

                # 음성 분석을 통한 실시간 피치 검출 및 MIDI 음정 번호 환산
                f0, vcd, _ = librosa.pyin(y[int(start*sr):int(end*sr)], fmin=librosa.note_to_hz('C3'), fmax=librosa.note_to_hz('C6'))
                midi_val = hz_to_midi(np.nanmedian(f0[vcd])) if any(vcd) else 64

                # 계산된 시간 파라미터 값 추출
                note_t = int(start * tps)
                note_dur = max(int((end - start) * tps), 120) # 최소 길이 120틱 방어 코드

                # [요청사항 반영] 지정해주신 정식 <note> 및 <nStyle> 구조 출력부
                xml_content += f'''
			<note>
				<t>{note_t}</t>
				<dur>{note_dur}</dur>
				<n>{midi_val}</n>
				<v>64</v>
				<y><![CDATA[{hira}]]></y>
				<p><![CDATA[{hira}]]></p>
				<nStyle>
					<v id="accent">50</v>
					<v id="bendDep">0</v>
					<v id="bendLen">0</v>
					<v id="decay">50</v>
					<v id="fallPort">0</v>
					<v id="opening">127</v>
					<v id="risePort">0</v>
					<v id="vibLen">0</v>
					<v id="vibType">0</v>
				</nStyle>
			</note>'''

        # 6. 마무리
        xml_content += '''
		</vsPart>
	</vsTrack>
	<monoTrack>
	</monoTrack>
	<stTrack>
		<wavPart>
			<t>0</t>
			<playTime>{total_play_time_ticks}</playTime>
			<name><![CDATA[NewPart]]></name>
			<comment><![CDATA[New WAV Part]]></comment>
			<fs>44100</fs>
			<rs>16</rs>
			<nCh>2</nCh>
			<filePath><![CDATA[{original_filename}]]></filePath>
		</wavPart>
	</stTrack>
	<aux>
		<id><![CDATA[AUX_VST_HOST_CHUNK_INFO]]></id>
		<content><![CDATA[VlNDSwAAAAADAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=]]></content>
	</aux>
</vsq4>'''

        with open(vsq_p, "w", encoding="utf-8", newline='\r\n') as f:
            f.write(xml_content)

        return send_file(vsq_p, as_attachment=True)
    except Exception as e:
        return str(e), 500

