import os, whisper, librosa, torch, pykakasi
import numpy as np
import xml.etree.ElementTree as ET
from flask import Flask, request, send_file
from flask_cors import CORS
from pyngrok import ngrok

model = whisper.load_model("medium").to("cuda" if torch.cuda.is_available() else "cpu")
kks = pykakasi.kakasi()

from flask import Flask, request, send_file
from flask_cors import CORS
import os, numpy as np, librosa
from pyngrok import ngrok

app = Flask(__name__)
CORS(app)

def hz_to_midi(hz):
    if hz <= 0 or np.isnan(hz): return 64
    midi = int(round(12 * np.log2(hz / 440.0) + 69))
    return max(0, min(127, midi))

@app.route("/convert", methods=["POST"])
def convert():
    try:
        audio_file = request.files['file']
        bpm = int(request.form.get('bpm', 120))
        full_lyrics = request.form.get('full_lyrics', "")
        
        in_p, au_p, vsq_p = "input.wav", "temp.wav", "output.vsqx"
        audio_file.save(in_p)
        os.system(f'ffmpeg -i "{in_p}" -vn -acodec pcm_s16le -ar 22050 -ac 1 "{au_p}" -y')
        
        res = model.transcribe(au_p, language="ja", word_timestamps=True)
        y, sr = librosa.load(au_p, sr=22050)
        user_lyrics = [char for char in full_lyrics.replace(" ", "").replace("\n", "")]
        lyric_idx = 0

        # 1. XML 헤더 및 vVoiceTable
        xml_content = f'''<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<vsq4 xmlns="http://www.yamaha.co.jp/vocaloid/schema/vsq4/"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.yamaha.co.jp/vocaloid/schema/vsq4/ vsq4.xsd">
	<vender><![CDATA[Yamaha corporation]]></vender>
	<version><![CDATA[4.0.0.3]]></version>
	<vVoiceTable>
		<vVoice>
			<bs>0</bs><pc>0</pc>
			<id><![CDATA[BHNME578NG2S3HD8]]></id>
			<name><![CDATA[MIKU_V4X_Original]]></name>
			<vPrm><bre>0</bre><bri>0</bri><cle>0</cle><gen>0</gen><ope>0</ope></vPrm>
		</vVoice>
	</vVoiceTable>'''

        # 2. mixer (순서 준수)
        xml_content += '''
	<mixer>
		<masterUnit><oDev>0</oDev><rLvl>0</rLvl><vol>0</vol></masterUnit>
		<vsUnit><tNo>0</tNo><iGin>0</iGin><sLvl>-898</sLvl><sEnable>0</sEnable><m>0</m><s>0</s><pan>64</pan><vol>0</vol></vsUnit>
		<monoUnit><iGin>0</iGin><sLvl>-898</sLvl><sEnable>0</sEnable><m>0</m><s>0</s><pan>64</pan><vol>0</vol></monoUnit>
		<stUnit><iGin>0</iGin><m>0</m><s>0</s><vol>0</vol></stUnit>
	</mixer>'''

        # 3. masterTrack
        xml_content += f'''
	<masterTrack>
		<seqLen>4800</seqLen>
		<tempo><t>0</t><v>{bpm * 100}</v></tempo>
	</masterTrack>'''

        # 4. vsTrack 및 vsPart 설정 (요청하신 sPlug, pStyle 데이터 삽입)
        xml_content += f'''
	<vsTrack>
		<tNo>0</tNo>
		<name><![CDATA[Voice]]></name>
		<vsPart>
			<t>0</t>
			<playTime>614400</playTime>
			<name><![CDATA[NewPart]]></name>
			<comment><![CDATA[New Musical Part]]></comment>
			<sPlug>
				<id><![CDATA[ACA9C502-A04B-42b5-B2EB-5CEA36D16FCE]]></id>
				<name><![CDATA[VOCALOID2 Compatible Style]]></name>
				<version><![CDATA[3.0.0.1]]></version>
			</sPlug>
			<pStyle>
				<v id="accent">50</v>
				<v id="bendDep">8</v>
				<v id="bendLen">0</v>
				<v id="decay">50</v>
				<v id="fallPort">0</v>
				<v id="opening">127</v>
				<v id="risePort">0</v>
			</pStyle>
			<singer><t>0</t><bs>0</bs><pc>0</pc></singer>
			<cc><t>0</t><v id="R">127</v></cc>
			<cc><t>0</t><v id="X">15</v></cc>
			<cc><t>0</t><v id="G">40</v></cc>
			<cc><t>0</t><v id="C">10</v></cc>
			<cc><t>0</t><v id="D">64</v></cc>'''

        # 5. Note 생성부
        tps = (bpm / 60) * 480
        for seg in res['segments']:
            for w in seg.get('words', []):
                start, end, text = w['start'], w['end'], w['word'].strip()
                if not text: continue

                if user_lyrics and lyric_idx < len(user_lyrics):
                    hira = "".join([i['hira'] for i in kks.convert(user_lyrics[lyric_idx])])
                    lyric_idx += 1
                else:
                    hira = "".join([i['hira'] for i in kks.convert(text)])

                f0, vcd, _ = librosa.pyin(y[int(start*sr):int(end*sr)], fmin=librosa.note_to_hz('C3'), fmax=librosa.note_to_hz('C6'))
                midi_val = hz_to_midi(np.nanmedian(f0[vcd])) if any(vcd) else 64

                xml_content += f'''
			<note>
				<t>{int(start * tps)}</t>
				<dur>{max(int((end - start) * tps), 120)}</dur>
				<n>{midi_val}</n>
				<v>64</v>
				<y><![CDATA[{hira}]]></y>
				<p lock="1"><![CDATA[{hira}]]></p>
				<nStyle>
					<v id="accent">64</v><v id="bendDep">0</v><v id="bendLen">0</v><v id="decay">50</v>
					<v id="fallPort">0</v><v id="opening">127</v><v id="risePort">0</v><v id="vibLen">0</v><v id="vibType">0</v>
				</nStyle>
			</note>'''

        # 6. 마무리
        xml_content += '''
		</vsPart>
	</vsTrack>
</vsq4>'''

        with open(vsq_p, "w", encoding="utf-8", newline='\r\n') as f:
            f.write(xml_content)

        return send_file(vsq_p, as_attachment=True)
    except Exception as e:
        return str(e), 500

