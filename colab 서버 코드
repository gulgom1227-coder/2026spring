def hz_to_midi(hz):
    if hz <= 0 or np.isnan(hz): return 64
    midi = int(round(12 * np.log2(hz / 440.0) + 69))
    return max(0, min(127, midi))

# 일본어 로마자 발음을 보컬로이드 표준 음소(Phoneme) 형태로 변환하는 함수
def convert_to_phoneme(text):
    result = kks.convert(text)
    hira_list = [i['hira'] for i in result]
    roma_list = [i['hepburn'] for i in result]
    
    hira_str = "".join(hira_list)
    
    # 보컬로이드 자음+모음 음소 분리 규칙 적용 가이드라인
    phonemes = []
    for roma in roma_list:
        roma = roma.lower()
        # 보컬로이드 예외 발음 처리 (sh, ch, ts 등 자음 결합 패턴 분리)
        if roma.startswith(('sha', 'shu', 'sho')):
            p = f"S {roma[-1]}"
        elif roma.startswith(('cha', 'chu', 'cho')):
            p = f"tS {roma[-1]}"
        elif roma.startswith(('tsu',)):
            p = "ts u"
        elif roma == "shi": p = "S i"
        elif roma == "chi": p = "tS i"
        elif roma == "fu": p = "p\ i"
        elif len(roma) > 1 and roma[-1] in ['a', 'i', 'u', 'e', 'o']:
            # 일반적인 자음 + 모음 분리 (예: ka -> k a / yu -> j u)
            consonant = roma[:-1]
            vowel = roma[-1]
            # 보컬로이드 로마자 자음 맵핑 표준화
            if consonant == 'y': consonant = 'j'
            elif consonant == 'j': consonant = 'dZ'
            elif consonant == 'c': consonant = 'k'
            phonemes.append(f"{consonant} {vowel}")
            continue
        else:
            # 단독 모음 또는 받침(n) 처리
            if roma == 'n': p = 'M'
            else: p = roma
        phonemes.append(p)
        
    phoneme_str = " ".join(phonemes)
    return hira_str, phoneme_str

@app.route("/convert", methods=["POST"])
def convert():
    try:
        audio_file = request.files['file']
        bpm = int(request.form.get('bpm', 120))
        full_lyrics = request.form.get('full_lyrics', "")

        original_filename = audio_file.filename if audio_file.filename else "input.wav"

        in_p, au_p, vsq_p = "input.wav", "temp.wav", "output.vsqx"
        audio_file.save(in_p)
        os.system(f'ffmpeg -i "{in_p}" -vn -acodec pcm_s16le -ar 22050 -ac 1 "{au_p}" -y')

        duration_sec = librosa.get_duration(path=au_p)

        res = model.transcribe(au_p, language="ja", word_timestamps=True)
        y, sr = librosa.load(au_p, sr=22050)
        user_lyrics = [char for char in full_lyrics.replace(" ", "").replace("\n", "").replace("\r", "")]
        lyric_idx = 0

        tps = (bpm / 60) * 480
        total_play_time_ticks = int(duration_sec * tps)

        # 1. XML 헤더 및 vVoiceTable
        xml_content = f'''
