#html
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>vsqx 변환</title> <style>
        :root {
            --primary-color: #007bff;
            --bg-color: #f4f7f9;
            --card-bg: #ffffff;
            --text-color: #333;
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: var(--bg-color);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .card { 
            background: var(--card-bg); 
            padding: 30px; 
            border-radius: 15px; 
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 500px; 
        }

        h2 { color: var(--primary-color); text-align: center; margin-bottom: 20px; }

        label { display: block; margin-top: 15px; font-weight: bold; color: #555; }

        /* 가사 입력창 색상 강제 지정 */
        input, textarea { 
            width: 100%; 
            margin-top: 8px; 
            box-sizing: border-box; 
            border: 2px solid #ddd;
            border-radius: 8px;
            padding: 12px;
            font-size: 14px;
            color: #000000 !important; /* 글자색 검정 */
            background-color: #ffffff !important; /* 배경색 흰색 */
        }

        textarea::placeholder {
            color: #999;
        }

        textarea:focus, input:focus {
            border-color: var(--primary-color);
            outline: none;
            background-color: #ffffff !important;
        }

        button { 
            margin-top: 25px;
            width: 100%;
            padding: 15px; 
            background: var(--primary-color); 
            color: white; 
            border: none; 
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer; 
            transition: background 0.3s;
        }

        button:hover { background: #0056b3; }

        #status { 
            margin-top: 15px; 
            text-align: center; 
            font-size: 14px; 
            color: #666;
            min-height: 20px;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>vsqx 변환</h2>
        
        <label>1. 오디오 파일 (.wav)</label>
        <input type="file" id="fileInput" accept="audio/*">
        
        <label>2. 곡의 BPM</label>
        <input type="number" id="bpmInput" value="120">
        
        <label>3. 가사</label>
        <textarea id="lyricsInput" rows="6" placeholder="여기에 가사를 입력하세요."></textarea>
        
        <button onclick="uploadFile()">VSQX 생성 시작</button>
        <p id="status"></p>
    </div>

    <script>
        // 코랩의 ✅ 서버 주소를 이곳에 붙여넣으세요.
        const API_URL = "https://disfigure-pasta-waggle.ngrok-free.dev"; 

        async function uploadFile() {
            const status = document.getElementById('status');
            const file = document.getElementById('fileInput').files[0];
            const bpm = document.getElementById('bpmInput').value;
            const lyrics = document.getElementById('lyricsInput').value;

            if(!file) return alert("파일을 선택해 주세요!");
            if(!API_URL.startsWith("http")) return alert("코랩 주소를 입력해 주세요!");

            status.innerText = "⏳ 서버에서 변환 중입니다...";
            status.style.color = "#007bff";

            const formData = new FormData();
            formData.append("file", file);
            formData.append("bpm", bpm);
            formData.append("full_lyrics", lyrics);

            try {
                const response = await fetch(`${API_URL}/convert`, { 
                    method: "POST", 
                    body: formData 
                });

                if(!response.ok) throw new Error("서버 응답 실패");

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `vsqx_result_${Date.now()}.vsqx`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                
                status.innerText = "✅ 성공! 파일이 다운로드되었습니다.";
                status.style.color = "#28a745";
            } catch (e) {
                status.innerText = "❌ 오류: " + e.message;
                status.style.color = "#dc3545";
            }
        }
    </script>
</body>
</html>
