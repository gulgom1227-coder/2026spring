<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VOCALOID VSQX Advanced Workstation</title>
    <style>
        :root {
            --bg-dark: #0f111a;
            --bg-card: #161925;
            --text-main: #f0f2f5;
            --text-muted: #8a92a6;
            --accent-color: #39c5bb; /* 하츠네 미쿠 시그니처 민트 */
            --accent-hover: #2ba89f;
            --border-color: #262b40;
            --list-hover: #1e2235;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
        body { background-color: var(--bg-dark); color: var(--text-main); display: flex; flex-direction: column; align-items: center; padding: 50px 20px; }
        .station-wrapper { width: 100%; max-width: 680px; display: flex; flex-direction: column; gap: 35px; }
        .vsqx-chamber, .archive-chamber { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; width: 100%; padding: 40px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4); }
        .chamber-title { font-size: 20px; font-weight: 700; margin-bottom: 6px; }
        .chamber-subtitle { font-size: 13px; color: var(--text-muted); margin-bottom: 30px; }
        .form-group { margin-bottom: 24px; }
        .form-label { display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; }
        .file-dropzone { border: 2px dashed var(--border-color); border-radius: 10px; padding: 30px 20px; text-align: center; cursor: pointer; }
        .file-name-display { font-weight: 600; color: var(--accent-color); margin-top: 5px; display: none; }
        #file-input { display: none; }
        input[type="number"], textarea { width: 100%; background-color: rgba(0, 0, 0, 0.2); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px 16px; color: var(--text-main); outline: none; }
        textarea { resize: vertical; height: 90px; }
        .submit-btn { width: 100%; background-color: var(--accent-color); color: #000; border: none; border-radius: 8px; padding: 14px; font-size: 15px; font-weight: 700; cursor: pointer; transition: all 0.2s; }
        .submit-btn:hover { background-color: var(--accent-hover); }
        .submit-btn:disabled { background-color: var(--border-color); color: var(--text-muted); cursor: not-allowed; }
        .status-message { margin-top: 20px; padding: 12px; border-radius: 8px; font-size: 13px; display: none; text-align: center; }
        .status-message.error { background-color: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }
        .status-message.success { background-color: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
        .archive-list { display: flex; flex-direction: column; gap: 12px; }
        .archive-item { display: flex; justify-content: space-between; align-items: center; background-color: rgba(0, 0, 0, 0.15); border: 1px solid var(--border-color); border-radius: 10px; padding: 16px 20px; }
        .song-info { display: flex; flex-direction: column; gap: 4px; }
        .song-title { font-size: 15px; font-weight: 600; }
        .song-meta { font-size: 12px; color: var(--text-muted); }
        .download-action-btn { background-color: transparent; color: var(--accent-color); border: 1px solid var(--accent-color); border-radius: 6px; padding: 8px 16px; font-size: 12px; font-weight: 700; cursor: pointer; }
        .download-action-btn:hover { background-color: var(--accent-color); color: #000; }
    </style>
</head>
<body>

<div class="station-wrapper">

    <div class="vsqx-chamber">
        <div class="chamber-title">⚡ AI VSQX CONVERTER</div>
        <div class="chamber-subtitle">오디오 소스를 정밀 분석하여 보컬로이드 4 규격 시퀀스 파일로 추출합니다.</div>
        <form id="convert-form">
            <div class="form-group">
                <label class="form-label">Voice Source File</label>
                <div class="file-dropzone" id="dropzone">
                    <p id="dropzone-text">WAV / MP3 소스를 여기에 드롭하거나 창을 탭하세요.</p>
                    <p class="file-name-display" id="file-name"></p>
                    <input type="file" id="file-input" accept="audio/*" required>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" for="bpm-input">BPM Setup</label>
                <input type="number" id="bpm-input" value="120" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="lyrics-input">Japanese Lyrics (Optional)</label>
                <textarea id="lyrics-input" placeholder="순서에 일치시킬 일본어 가사를 기입하세요."></textarea>
            </div>
            <button type="submit" class="submit-btn" id="submit-btn">START CONVERSION</button>
        </form>
        <div class="status-message" id="status-box"></div>
    </div>

    <div class="archive-chamber">
        <div class="chamber-title">📦 ORIGINAL WAV ARCHIVE</div>
        <div class="chamber-subtitle">작곡가들이 제공한 튜닝용 순수 원본 오디오(WAV) 소스 보관소입니다.</div>
        <div class="archive-list">
            <div class="archive-item">
                <div class="song-info">
                    <span class="song-title">멜트 (Melt / メルト)</span>
                    <span class="song-meta">Producer: ryo (supercell) | Format: WAV Audio</span>
                </div>
                <button class="download-action-btn" onclick="triggerAudioDownload('melt')">📥 WAV GET</button>
            </div>
            <div class="archive-item">
                <div class="song-info">
                    <span class="song-title">PPPP</span>
                    <span class="song-meta">Producer: TAK | Format: WAV Audio</span>
                </div>
                <button class="download-action-btn" onclick="triggerAudioDownload('pppp')">📥 WAV GET</button>
            </div>
            <div class="archive-item">
                <div class="song-info">
                    <span class="song-title">월드 이즈 마인 (World is Mine)</span>
                    <span class="song-meta">Producer: ryo (supercell) | Format: WAV Audio</span>
                </div>
                <button class="download-action-btn" onclick="triggerAudioDownload('world_is_mine')">📥 WAV GET</button>
            </div>
            <div class="archive-item">
                <div class="song-info">
                    <span class="song-title">천본앵 (Senbonzakura / 千本桜)</span>
                    <span class="song-meta">Producer: 黒うさP | Format: WAV Audio</span>
                </div>
                <button class="download-action-btn" onclick="triggerAudioDownload('senbonzakura')">📥 WAV GET</button>
            </div>
        </div>
    </div>

</div>

<script>
    // -------------------------------------------------------------
    // 💾 [WAV 오디오 Base64 데이터 스토리지]
    // 제공받으실 WAV 파일의 Base64 텍스트를 각 항목 따옴표 안에 넣어주세요.
    // -------------------------------------------------------------
    const embeddedAudioDatabase = {
        'melt': 
        'pppp': 
        'world_is_mine':
        'senbonzakura':     };

    // -------------------------------------------------------------
    // 🌍 [AI 변환기 핵심 연동 모듈]
    // -------------------------------------------------------------
    const SERVER_URL = "https://disfigure-pasta-waggle.ngrok-free.dev"; // 👈 실제 구동 중인 ngrok 주소 입력

    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input');
    const dropzoneText = document.getElementById('dropzone-text');
    const fileNameDisplay = document.getElementById('file-name');
    const form = document.getElementById('convert-form');
    const submitBtn = document.getElementById('submit-btn');
    const statusBox = document.getElementById('status-box');

    // 드롭존 파일 선택 처리
    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('dragover', (e) => { e.preventDefault(); });
    dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        if (e.dataTransfer.files.length > 0) { fileInput.files = e.dataTransfer.files; updateFileName(); }
    });
    fileInput.addEventListener('change', updateFileName);

    function updateFileName() {
        if (fileInput.files.length > 0) {
            dropzoneText.style.display = 'none';
            fileNameDisplay.textContent = fileInput.files[0].name;
            fileNameDisplay.style.display = 'block';
        }
    }

    // AI 변환 요청 비동기 전송 함수
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!fileInput.files[0]) { showStatus("오디오 파일을 선택해 주세요.", "error"); return; }

        submitBtn.disabled = true;
        submitBtn.textContent = "AI ANALYZING & CONVERTING...";
        statusBox.style.display = 'none';

        const formData = new FormData();
        formData.append('file', fileInput.files[0]);
        formData.append('bpm', document.getElementById('bpm-input').value);
        formData.append('full_lyrics', document.getElementById('lyrics-input').value);

        try {
            const targetUrl = SERVER_URL.endsWith('/') ? `${SERVER_URL}convert` : `${SERVER_URL}/convert`;
            const response = await fetch(targetUrl, { method: 'POST', body: formData });
            if (!response.ok) throw new Error("서버 연산 처리 중 에러가 발생했습니다.");

            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = downloadUrl;
            a.download = "output.vsqx";
            document.body.appendChild(a);
            a.click();
            a.remove();
            showStatus("성공적으로 VSQX 파일이 추출 및 다운로드되었습니다!", "success");
        } catch (error) {
            showStatus(error.message, "error");
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = "START CONVERSION";
        }
    });

    function showStatus(msg, type) {
        statusBox.textContent = msg;
        statusBox.className = `status-message ${type}`;
        statusBox.style.display = 'block';
    }

    // -------------------------------------------------------------
    // 📥 [로컬 WAV 다운로드 변환 엔진]
    // -------------------------------------------------------------
    function triggerAudioDownload(trackKey) {
        const base64String = embeddedAudioDatabase[trackKey];
        
        if (!base64String || base64String.length < 100) {
            alert(`'${trackKey}' 곡의 실제 WAV 파일 데이터가 주입되지 않았습니다.`);
            return;
        }

        try {
            const byteCharacters = atob(base64String);
            const byteNumbers = new Array(byteCharacters.length);
            for (let i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }
            const byteArray = new Uint8Array(byteNumbers);
            
            const audioBlob = new Blob([byteArray], { type: 'audio/wav' });
            const virtualUrl = URL.createObjectURL(audioBlob);
            
            const anchorNode = document.createElement('a');
            anchorNode.href = virtualUrl;
            anchorNode.download = `${trackKey}_original_source.wav`;
            
            document.body.appendChild(anchorNode);
            anchorNode.click();
            
            setTimeout(() => {
                document.body.removeChild(anchorNode);
                URL.revokeObjectURL(virtualUrl);
            }, 100);
        } catch (error) {
            alert("파일 복원 중 오류가 발생했습니다: " + error.message);
        }
    }
</script>
</body>
</html>
